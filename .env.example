# =========================
# Core backend configuration
# =========================

# Gemini key used by Atlantean backend for LLM generation.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Flask session security.
ATLANTEAN_SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
SESSION_COOKIE_SECURE=0

# Comma-separated CORS allowlist for backend APIs.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Redis host for primary low-latency persistence.
REDIS_HOST=localhost

# Agent Bus (independent of the legacy Gemini backend)
QUADRA_HUB_HOST=127.0.0.1
QUADRA_HUB_PORT=3002
QUADRA_DATA_DIR=.quadra-local
# Remote access requires a strong token and an HTTPS reverse proxy.
# QUADRA_HUB_TOKEN=generate-a-long-random-secret
QUADRA_HUB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Explicitly allow exact compatible API base URLs; redirect following is disabled.
# QUADRA_AGENT_ENDPOINTS=https://your-muse-api.example/v1,https://your-agent.example/v1
VITE_HUB_PROXY_TARGET=http://127.0.0.1:3002
